<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_evento"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_creme"
    android:orientation="vertical">

    <include
        android:id="@+id/include_demo"
        layout="@layout/view_demo_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:id="@+id/scroll_evento"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/evento_conteudo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. Hero -->
            <FrameLayout
                android:id="@+id/secao_topo"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:background="@color/brand_grafite">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/evento_banner_desc"
                    android:scaleType="centerCrop"
                    android:src="@drawable/paella_hero" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_paella_scrim_forte" />

                <TextView
                    android:id="@+id/btn_voltar"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_target"
                    android:layout_margin="@dimen/space_xs"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_back"
                    android:drawablePadding="6dp"
                    android:drawableTint="@color/brand_creme"
                    android:focusable="true"
                    android:fontFamily="@font/inter_variable"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/space_xs"
                    android:text="@string/detalhe_voltar"
                    android:textColor="@color/brand_creme"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:padding="@dimen/space_md">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_variable"
                        android:text="@string/evento_marca"
                        android:textAllCaps="true"
                        android:textColor="@color/brand_acafrao"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/barlow_condensed_bold"
                        android:text="@string/evento_headline"
                        android:textAllCaps="true"
                        android:textColor="@color/brand_creme"
                        android:textSize="40sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_variable"
                        android:text="@string/evento_apoio"
                        android:textColor="@color/brand_creme"
                        android:textSize="15sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- 2. Informações principais -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_paella_chip"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="@dimen/space_md">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="match_parent"
                            android:background="@color/brand_acafrao" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_variable"
                                android:text="@string/evento_data_rotulo"
                                android:textAllCaps="true"
                                android:textColor="@color/brand_grafite_muted"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/barlow_condensed_bold"
                                android:text="@string/evento_data_valor"
                                android:textColor="@color/brand_vinho"
                                android:textSize="40sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_variable"
                                android:text="@string/evento_data_dia"
                                android:textColor="@color/brand_grafite"
                                android:textSize="15sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/line" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="@dimen/space_md">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_location"
                            app:tint="@color/brand_mediterraneo" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_variable"
                                android:text="@string/evento_local_valor"
                                android:textColor="@color/brand_grafite"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_variable"
                                android:text="@string/evento_local_nota"
                                android:textColor="@color/brand_grafite_muted"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_cardapio"
                    style="@style/Widget.Paella.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:fontFamily="@font/inter_variable"
                    android:text="@string/evento_cta_cardapio" />
            </LinearLayout>

            <!-- 3. Um prato com propósito -->
            <LinearLayout
                android:id="@+id/secao_proposito"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_paella_header"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="24dp"
                        android:layout_height="8dp"
                        android:background="@color/brand_paprica" />

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginStart="4dp"
                        android:background="@color/brand_mediterraneo" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:fontFamily="@font/barlow_condensed_bold"
                    android:text="@string/evento_proposito_titulo"
                    android:textAllCaps="true"
                    android:textColor="@color/brand_acafrao"
                    android:textSize="32sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:fontFamily="@font/inter_variable"
                    android:lineSpacingExtra="3sp"
                    android:text="@string/evento_proposito_texto"
                    android:textColor="@color/brand_creme"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- 4. Sobre a ABADEUS -->
            <LinearLayout
                android:id="@+id/secao_abadeus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/space_lg">

                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:background="@color/brand_mediterraneo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/barlow_condensed_bold"
                        android:text="@string/evento_abadeus_titulo"
                        android:textAllCaps="true"
                        android:textColor="@color/brand_vinho"
                        android:textSize="30sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:fontFamily="@font/inter_variable"
                        android:lineSpacingExtra="3sp"
                        android:text="@string/evento_abadeus_texto"
                        android:textColor="@color/brand_grafite"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 5. Como participar -->
            <LinearLayout
                android:id="@+id/secao_participar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_lg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/barlow_condensed_bold"
                    android:text="@string/evento_participar_titulo"
                    android:textAllCaps="true"
                    android:textColor="@color/brand_vinho"
                    android:textSize="30sp" />

                <LinearLayout
                    android:id="@+id/lista_passos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Programação demonstrativa -->
            <LinearLayout
                android:id="@+id/secao_programacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_lg"
                android:paddingTop="@dimen/space_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/barlow_condensed_bold"
                    android:text="@string/evento_programacao_titulo"
                    android:textAllCaps="true"
                    android:textColor="@color/brand_vinho"
                    android:textSize="30sp" />

                <LinearLayout
                    android:id="@+id/lista_programacao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/inter_variable"
                    android:text="@string/evento_programacao_nota"
                    android:textColor="@color/brand_grafite_muted"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mapa"
                    style="@style/Widget.Paella.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:fontFamily="@font/inter_variable"
                    android:text="@string/evento_ver_mapa" />
            </LinearLayout>

            <!-- 6. Dúvidas frequentes -->
            <LinearLayout
                android:id="@+id/secao_duvidas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/barlow_condensed_bold"
                    android:text="@string/evento_duvidas_titulo"
                    android:textAllCaps="true"
                    android:textColor="@color/brand_vinho"
                    android:textSize="30sp" />

                <LinearLayout
                    android:id="@+id/lista_faq"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:background="@drawable/bg_paella_chip"
                    android:orientation="vertical" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_variable"
                android:gravity="center"
                android:paddingBottom="@dimen/space_lg"
                android:paddingHorizontal="@dimen/space_md"
                android:text="@string/evento_rodape"
                android:textColor="@color/brand_grafite_muted"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
