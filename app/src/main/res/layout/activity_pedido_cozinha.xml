<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_pedido_cozinha"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_creme"
    android:orientation="vertical">

    <include
        android:id="@+id/include_demo"
        layout="@layout/view_demo_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_md">

            <TextView
                android:id="@+id/btn_voltar"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:drawableStart="@drawable/ic_back"
                android:drawablePadding="6dp"
                android:drawableTint="@color/brand_vinho"
                android:focusable="true"
                android:fontFamily="@font/inter_variable"
                android:gravity="center_vertical"
                android:text="@string/detalhe_voltar"
                android:textColor="@color/brand_vinho"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:fontFamily="@font/barlow_condensed_bold"
                android:includeFontPadding="false"
                android:text="@string/pedido_cozinha_titulo"
                android:textAllCaps="true"
                android:textColor="@color/brand_vinho"
                android:textSize="34sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txt_numero"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/barlow_condensed_bold"
                    android:includeFontPadding="false"
                    android:textColor="@color/brand_grafite"
                    android:textSize="28sp" />

                <TextView
                    android:id="@+id/txt_status"
                    android:background="@drawable/bg_paella_status"
                    android:fontFamily="@font/inter_variable"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:id="@+id/txt_cliente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_variable"
                android:textColor="@color/brand_grafite_muted"
                android:textSize="14sp" />

            <!-- Itens -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_home_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_variable"
                    android:text="@string/pedido_cozinha_itens"
                    android:textColor="@color/brand_vinho"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/lista_itens"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/txt_pagamento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/inter_variable"
                    android:textColor="@color/brand_grafite_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txt_total"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/barlow_condensed_bold"
                    android:gravity="end"
                    android:textColor="@color/brand_vinho"
                    android:textSize="28sp" />
            </LinearLayout>

            <!-- Previsão -->
            <LinearLayout
                android:id="@+id/card_previsao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/bg_home_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_variable"
                    android:text="@string/pedido_cozinha_previsao"
                    android:textColor="@color/brand_vinho"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btn_prev_menos"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_stepper_grupo"
                        android:contentDescription="@string/pedido_cozinha_ajustar_menos"
                        android:src="@drawable/ic_minus"
                        app:tint="@color/brand_vinho" />

                    <TextView
                        android:id="@+id/txt_previsao_valor"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/barlow_condensed_bold"
                        android:gravity="center"
                        android:textColor="@color/brand_grafite"
                        android:textSize="22sp" />

                    <ImageButton
                        android:id="@+id/btn_prev_mais"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_stepper_grupo"
                        android:contentDescription="@string/pedido_cozinha_ajustar_mais"
                        android:src="@drawable/ic_plus"
                        app:tint="@color/brand_vinho" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/inter_variable"
                    android:text="@string/pedido_cozinha_previsao_nota"
                    android:textColor="@color/brand_grafite_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_acao"
                style="@style/Widget.Paella.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:fontFamily="@font/inter_variable"
                android:minHeight="56dp"
                android:textColor="@color/brand_vinho" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:fontFamily="@font/inter_variable"
                android:text="@string/pedido_cozinha_aviso"
                android:textColor="@color/brand_grafite_muted"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
