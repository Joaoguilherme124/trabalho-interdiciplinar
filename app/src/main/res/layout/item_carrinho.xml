<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_sm"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/radius_brand"
    app:cardElevation="0dp"
    app:strokeColor="@color/line"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/img_produto"
            android:layout_width="88dp"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:minHeight="112dp"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="@dimen/space_sm">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txt_titulo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/barlow_condensed_bold"
                    android:maxLines="2"
                    android:textColor="@color/brand_grafite"
                    android:textSize="20sp" />

                <ImageButton
                    android:id="@+id/btn_remove"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="-8dp"
                    android:layout_marginEnd="-8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_remover"
                    android:src="@android:drawable/ic_menu_delete"
                    app:tint="@color/brand_paprica" />
            </LinearLayout>

            <TextView
                android:id="@+id/txt_loja"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_variable"
                android:textColor="@color/brand_grafite_muted"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_minus"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_paella_stepper"
                    android:contentDescription="@string/cd_diminuir"
                    android:src="@drawable/ic_minus"
                    app:tint="@color/brand_vinho" />

                <TextView
                    android:id="@+id/txt_qty"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_variable"
                    android:gravity="center"
                    android:textColor="@color/brand_grafite"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btn_plus"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_paella_add"
                    android:contentDescription="@string/cd_aumentar"
                    android:src="@drawable/ic_plus"
                    app:tint="@color/brand_grafite" />

                <TextView
                    android:id="@+id/txt_preco"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1"
                    android:fontFamily="@font/barlow_condensed_bold"
                    android:gravity="end"
                    android:textColor="@color/brand_vinho"
                    android:textSize="22sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
