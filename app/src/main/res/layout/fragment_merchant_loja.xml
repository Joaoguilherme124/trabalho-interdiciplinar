<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_creme"
    android:orientation="vertical">

    <include
        android:id="@+id/include_demo"
        layout="@layout/view_demo_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:fontFamily="@font/barlow_condensed_bold"
                android:includeFontPadding="false"
                android:text="@string/minha_loja_titulo"
                android:textAllCaps="true"
                android:textColor="@color/brand_vinho"
                android:textSize="36sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_home_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <TextView
                    android:id="@+id/txt_loja_inicial"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_loja_avatar"
                    android:fontFamily="@font/barlow_condensed_bold"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:textColor="@color/brand_creme"
                    android:textSize="28sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txt_loja_nome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/barlow_condensed_bold"
                        android:includeFontPadding="false"
                        android:textColor="@color/brand_vinho"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/txt_loja_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_selo_adicionado"
                        android:fontFamily="@font/inter_variable"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:textColor="@color/brand_creme"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bloco_sem_loja"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_variable"
                    android:text="@string/minha_loja_sem_loja"
                    android:textColor="@color/brand_grafite"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_cadastrar_loja"
                    style="@style/Widget.Paella.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/inter_variable"
                    android:text="@string/cozinha_cadastrar_loja"
                    android:textColor="@color/brand_vinho" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bloco_form_loja"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/inter_variable"
                    android:text="@string/minha_loja_aviso"
                    android:textColor="@color/brand_grafite_muted"
                    android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/inter_variable"
                android:labelFor="@id/edt_loja_nome"
                android:text="@string/minha_loja_nome"
                android:textColor="@color/brand_vinho"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edt_loja_nome"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_campo_marca"
                android:fontFamily="@font/inter_variable"
                android:importantForAutofill="no"
                android:minHeight="48dp"
                android:paddingHorizontal="14dp"
                android:textColor="@color/brand_grafite"
                android:textSize="15sp"
                android:inputType="textCapWords" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/inter_variable"
                android:labelFor="@id/edt_loja_descricao"
                android:text="@string/minha_loja_descricao"
                android:textColor="@color/brand_vinho"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edt_loja_descricao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_campo_marca"
                android:fontFamily="@font/inter_variable"
                android:importantForAutofill="no"
                android:minHeight="48dp"
                android:paddingHorizontal="14dp"
                android:textColor="@color/brand_grafite"
                android:textSize="15sp"
                android:gravity="top" android:inputType="textMultiLine|textCapSentences" android:minLines="3" android:paddingVertical="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/inter_variable"
                android:labelFor="@id/edt_loja_telefone"
                android:text="@string/minha_loja_telefone"
                android:textColor="@color/brand_vinho"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edt_loja_telefone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_campo_marca"
                android:fontFamily="@font/inter_variable"
                android:importantForAutofill="no"
                android:minHeight="48dp"
                android:paddingHorizontal="14dp"
                android:textColor="@color/brand_grafite"
                android:textSize="15sp"
                android:inputType="phone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/inter_variable"
                android:labelFor="@id/edt_loja_endereco"
                android:text="@string/minha_loja_endereco"
                android:textColor="@color/brand_vinho"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edt_loja_endereco"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_campo_marca"
                android:fontFamily="@font/inter_variable"
                android:importantForAutofill="no"
                android:minHeight="48dp"
                android:paddingHorizontal="14dp"
                android:textColor="@color/brand_grafite"
                android:textSize="15sp"
                android:inputType="textPostalAddress" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/inter_variable"
                android:labelFor="@id/spinner_loja_categoria"
                android:text="@string/minha_loja_categoria"
                android:textColor="@color/brand_vinho"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinner_loja_categoria"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_campo_marca"
                android:paddingHorizontal="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/inter_variable"
                android:labelFor="@id/edt_loja_cnpj"
                android:text="@string/minha_loja_cnpj"
                android:textColor="@color/brand_vinho"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edt_loja_cnpj"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_campo_marca"
                android:fontFamily="@font/inter_variable"
                android:importantForAutofill="no"
                android:minHeight="48dp"
                android:paddingHorizontal="14dp"
                android:textColor="@color/brand_grafite"
                android:textSize="15sp"
                android:enabled="false" android:alpha="0.7" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_salvar_loja"
                    style="@style/Widget.Paella.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:fontFamily="@font/inter_variable"
                    android:minHeight="56dp"
                    android:text="@string/minha_loja_salvar"
                    android:textColor="@color/brand_vinho" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="@font/barlow_condensed_bold"
                android:includeFontPadding="false"
                android:text="@string/minha_loja_conta"
                android:textAllCaps="true"
                android:textColor="@color/brand_vinho"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/txt_conta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/inter_variable"
                android:textColor="@color/brand_grafite"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_alterar_conta"
                style="@style/Widget.Paella.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/inter_variable"
                android:minHeight="52dp"
                android:text="@string/conta_alterar" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sair"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/inter_variable"
                android:minHeight="52dp"
                android:text="@string/sair"
                android:textColor="@color/brand_paprica"
                app:strokeColor="@color/brand_paprica" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
