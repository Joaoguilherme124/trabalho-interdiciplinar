<?xml version="1.0" encoding="utf-8"?>
<!-- Atalho da Início: caixa de ícone no topo e rótulo centralizado. Preenchido por HomeFragment. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="4dp"
    android:layout_weight="1"
    android:background="@drawable/bg_home_atalho"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:minHeight="@dimen/touch_target"
    android:orientation="vertical"
    android:paddingHorizontal="4dp"
    android:paddingVertical="12dp">

    <FrameLayout
        android:id="@+id/atalho_caixa"
        android:layout_width="44dp"
        android:layout_height="44dp">

        <ImageView
            android:id="@+id/atalho_icone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:tint="@color/brand_vinho" />
    </FrameLayout>

    <TextView
        android:id="@+id/atalho_rotulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minLines="2"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/inter_variable"
        android:gravity="top|center_horizontal"
        android:textColor="@color/brand_grafite"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
