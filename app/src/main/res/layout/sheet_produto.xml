<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Alça de arraste, minimizar e favorito -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_sheet_alca"
            android:importantForAccessibility="no" />

        <ImageButton
            android:id="@+id/btn_fechar_sheet"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/sheet_fechar_cd"
            android:padding="12dp"
            android:src="@drawable/ic_seta_baixo" />

        <ImageButton
            android:id="@+id/btn_favorito_sheet"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/sel_favorito" />
    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_sheet"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/brand_grafite"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/img_produto_sheet"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/txt_categoria_sheet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/inter_variable"
                android:letterSpacing="0.08"
                android:textAllCaps="true"
                android:textColor="@color/brand_grafite_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_titulo_sheet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/barlow_condensed_bold"
                android:includeFontPadding="false"
                android:paddingTop="2dp"
                android:textColor="@color/brand_vinho"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/txt_preco_sheet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_variable"
                android:textColor="@color/brand_vinho"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_descricao_sheet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/inter_variable"
                android:lineSpacingExtra="3sp"
                android:textColor="@color/brand_grafite"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_home_card"
                android:drawableStart="@drawable/ic_home_sacola"
                android:drawablePadding="10dp"
                android:drawableTint="@color/brand_vinho"
                android:fontFamily="@font/inter_variable"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:text="@string/sheet_retirada_info"
                android:textColor="@color/brand_grafite"
                android:textSize="13sp" />

            <!-- Quem prepara -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/barlow_condensed_bold"
                android:includeFontPadding="false"
                android:text="@string/sheet_quem_prepara"
                android:textAllCaps="true"
                android:textColor="@color/brand_vinho"
                android:textSize="24sp" />

            <LinearLayout
                android:id="@+id/card_loja_sheet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_home_card"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txt_loja_inicial"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_loja_avatar"
                        android:fontFamily="@font/barlow_condensed_bold"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:textColor="@color/brand_creme"
                        android:textSize="24sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txt_loja_nome"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_variable"
                            android:textColor="@color/brand_vinho"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txt_loja_desc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_variable"
                            android:textColor="@color/brand_grafite"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_ver_loja"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/inter_variable"
                    android:minHeight="48dp"
                    android:text="@string/sheet_ver_loja"
                    android:textColor="@color/brand_vinho"
                    app:strokeColor="@color/brand_vinho" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Rodapé de compra: sempre visível -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFDF9"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_stepper_grupo"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_menos_sheet"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_minus"
                    app:tint="@color/brand_vinho" />

                <TextView
                    android:id="@+id/txt_qtd_sheet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_variable"
                    android:gravity="center"
                    android:minWidth="28dp"
                    android:textColor="@color/brand_grafite"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btn_mais_sheet"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_plus"
                    app:tint="@color/brand_vinho" />
            </LinearLayout>

            <TextView
                android:id="@+id/txt_total_sheet"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="@font/barlow_condensed_bold"
                android:gravity="end"
                android:includeFontPadding="false"
                android:textColor="@color/brand_vinho"
                android:textSize="28sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_adicionar_sheet"
            style="@style/Widget.Paella.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/inter_variable"
            android:maxLines="2"
            android:minHeight="52dp"
            android:text="@string/sheet_adicionar"
            android:textColor="@color/brand_vinho" />
    </LinearLayout>
</LinearLayout>
