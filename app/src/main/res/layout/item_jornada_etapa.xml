<?xml version="1.0" encoding="utf-8"?>
<!-- Uma etapa da linha do tempo: marcador + conector à esquerda, textos à direita. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="44dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp">

            <View
                android:id="@+id/etapa_halo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_etapa_halo"
                android:importantForAccessibility="no"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/etapa_marcador"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center">

                <ImageView
                    android:id="@+id/etapa_icone"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no" />
            </FrameLayout>
        </FrameLayout>

        <View
            android:id="@+id/etapa_linha"
            android:layout_width="3dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/etapa_textos"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingBottom="16dp"
        android:paddingTop="4dp">

        <TextView
            android:id="@+id/etapa_titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_variable"
            android:textColor="@color/brand_grafite"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/etapa_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/inter_variable"
            android:textColor="@color/brand_grafite_muted"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
