<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_loja_detalhe"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_creme"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/btn_voltar"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:drawableStart="@drawable/ic_back"
            android:drawablePadding="6dp"
            android:drawableTint="@color/brand_vinho"
            android:focusable="true"
            android:fontFamily="@font/inter_variable"
            android:gravity="center_vertical"
            android:text="@string/detalhe_voltar"
            android:textColor="@color/brand_vinho"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_nome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/barlow_condensed_bold"
            android:includeFontPadding="false"
            android:textAllCaps="true"
            android:textColor="@color/brand_vinho"
            android:textSize="32sp" />

        <TextView
            android:id="@+id/txt_categoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/inter_variable"
            android:textColor="@color/brand_grafite"
            android:textSize="14sp" />

        <View
            android:layout_width="45dp"
            android:layout_height="3dp"
            android:layout_marginTop="8dp"
            android:background="@color/brand_acafrao"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/txt_descricao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/inter_variable"
            android:textColor="@color/brand_grafite"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txt_endereco"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/inter_variable"
            android:textColor="@color/brand_grafite_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/barlow_condensed_bold"
        android:includeFontPadding="false"
        android:paddingHorizontal="16dp"
        android:text="@string/loja_catalogo"
        android:textAllCaps="true"
        android:textColor="@color/brand_vinho"
        android:textSize="24sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_produtos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="20dp" />
</LinearLayout>
