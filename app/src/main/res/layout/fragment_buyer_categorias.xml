<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_creme">

    <include
        android:id="@+id/include_demo"
        layout="@layout/view_demo_banner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Cabeçalho compacto: título, apoio, traço açafrão e logotipo -->
    <LinearLayout
        android:id="@+id/cabecalho_cardapio"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/include_demo">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_titulo_tela"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/barlow_condensed_bold"
                android:includeFontPadding="false"
                android:text="@string/cardapio_titulo"
                android:textAllCaps="true"
                android:textColor="@color/brand_vinho"
                android:textSize="34sp" />

            <TextView
                android:id="@+id/txt_apoio_cardapio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_variable"
                android:text="@string/cardapio_apoio"
                android:textColor="@color/brand_grafite"
                android:textSize="13sp" />

            <View
                android:layout_width="40dp"
                android:layout_height="3dp"
                android:layout_marginTop="8dp"
                android:background="@color/brand_acafrao"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <ImageView
            android:id="@+id/logo_cardapio"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/logo_cd"
            android:scaleType="fitEnd"
            android:src="@drawable/logo_paella_beneficente" />
    </LinearLayout>

    <!-- Busca no cardápio + filtro de favoritos -->
    <LinearLayout
        android:id="@+id/linha_busca"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cabecalho_cardapio">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_busca">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_busca_vinho" />

            <EditText
                android:id="@+id/edt_busca"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:fontFamily="@font/inter_variable"
                android:ellipsize="end"
                android:hint="@string/busca_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="44dp"
                android:paddingEnd="48dp"
                android:textColor="@color/brand_grafite"
                android:textColorHint="@color/brand_grafite_muted"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btn_limpar_busca"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical|end"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/busca_limpar_cd"
                android:padding="13dp"
                android:src="@drawable/ic_fechar"
                android:visibility="gone" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/btn_filtro_favoritos"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_busca"
            android:contentDescription="@string/favoritos_filtro_cd"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/sel_favorito" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_categorias"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/linha_busca" />

    <!-- A lista termina acima da barra de pedido: nada fica coberto por ela. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_produtos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/bar_carrinho"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rv_categorias" />

    <LinearLayout
        android:id="@+id/estado_vazio"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="40dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/rv_produtos">

        <TextView
            android:id="@+id/txt_vazio_titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/barlow_condensed_bold"
            android:gravity="center"
            android:textAllCaps="true"
            android:textColor="@color/brand_vinho"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/txt_vazio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/inter_variable"
            android:gravity="center"
            android:textColor="@color/brand_grafite_muted"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_vazio_acao"
            style="@style/Widget.Paella.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/inter_variable" />
    </LinearLayout>

    <!-- Barra flutuante de pedido: resumo do carrinho acima da navegação inferior -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bar_carrinho"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginVertical="8dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:cardBackgroundColor="#FFFFFDF9"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:rippleColor="@color/brand_acafrao"
        app:strokeColor="@color/brand_acafrao"
        app:strokeWidth="1.5dp">

        <LinearLayout
            android:id="@+id/barra_conteudo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:id="@+id/barra_linha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/barra_miniaturas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txt_barra_itens"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_variable"
                        android:maxLines="2"
                        android:textColor="@color/brand_grafite_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txt_barra_total"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autoSizeMaxTextSize="24sp"
                        android:autoSizeMinTextSize="16sp"
                        android:autoSizeTextType="uniform"
                        android:fontFamily="@font/barlow_condensed_bold"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/brand_vinho"
                        android:textSize="24sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_barra_ver"
                    style="@style/Widget.Paella.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/inter_variable"
                    android:minHeight="48dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="12dp"
                    android:text="@string/barra_ver_pedido"
                    android:textColor="@color/brand_vinho"
                    android:textSize="13sp"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_login_seta"
                    app:iconGravity="textEnd"
                    app:iconPadding="6dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/brand_vinho" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
