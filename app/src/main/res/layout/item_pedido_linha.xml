<?xml version="1.0" encoding="utf-8"?>
<!-- Linha de item de pedido: quantidade, nome e subtotal. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="6dp">

    <TextView
        android:id="@+id/txt_linha_qtd"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_variable"
        android:textColor="@color/brand_vinho"
        android:textSize="15sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txt_linha_titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_variable"
            android:textColor="@color/brand_grafite"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/txt_linha_unitario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_variable"
            android:textColor="@color/brand_grafite_muted"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/txt_linha_subtotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:fontFamily="@font/inter_variable"
        android:textColor="@color/brand_grafite"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
