<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_painel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_creme"
    android:orientation="vertical">

    <include
        android:id="@+id/include_demo"
        layout="@layout/view_demo_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_md">

            <TextView
                android:id="@+id/btn_voltar"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:drawableStart="@drawable/ic_back"
                android:drawablePadding="6dp"
                android:drawableTint="@color/brand_vinho"
                android:focusable="true"
                android:fontFamily="@font/inter_variable"
                android:gravity="center_vertical"
                android:text="@string/detalhe_voltar"
                android:textColor="@color/brand_vinho"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/barlow_condensed_bold"
                android:includeFontPadding="false"
                android:text="@string/painel_titulo"
                android:textAllCaps="true"
                android:textColor="@color/brand_vinho"
                android:textSize="34sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/inter_variable"
                android:text="@string/painel_aviso"
                android:textColor="@color/brand_grafite_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txt_painel_pedido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:fontFamily="@font/inter_variable"
                android:textColor="@color/brand_vinho"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/grupo_acoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_preparo"
                    style="@style/Widget.Paella.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/inter_variable"
                    android:text="@string/painel_avancar_preparo" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pronto"
                    style="@style/Widget.Paella.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/inter_variable"
                    android:text="@string/painel_avancar_pronto" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_retirada"
                    style="@style/Widget.Paella.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/inter_variable"
                    android:text="@string/painel_simular_retirada" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_reiniciar"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/inter_variable"
                    android:minHeight="48dp"
                    android:text="@string/painel_reiniciar"
                    android:textColor="@color/brand_vinho"
                    app:strokeColor="@color/brand_vinho" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/inter_variable"
                    android:text="@string/painel_nota_cronograma"
                    android:textColor="@color/brand_grafite_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:background="@drawable/bg_home_card"
                android:gravity="center_vertical"
                android:minHeight="@dimen/touch_target"
                android:orientation="horizontal"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_variable"
                        android:text="@string/painel_modo_evento"
                        android:textColor="@color/brand_vinho"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/inter_variable"
                        android:text="@string/painel_modo_evento_desc"
                        android:textColor="@color/brand_grafite_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_modo_evento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/painel_modo_evento" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
