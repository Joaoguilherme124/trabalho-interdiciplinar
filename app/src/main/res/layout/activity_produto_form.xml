<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/txt_titulo_tela"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/novo_produto"
            android:textColor="@color/text_dark"
            android:textSize="22sp"
            android:textStyle="bold" />

        <EditText android:id="@+id/edt_titulo" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="16dp" android:background="@drawable/bg_input" android:hint="Título" android:paddingHorizontal="14dp" />
        <EditText android:id="@+id/edt_preco" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:background="@drawable/bg_input" android:hint="Preço" android:inputType="numberDecimal" android:paddingHorizontal="14dp" />
        <EditText android:id="@+id/edt_estoque" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:background="@drawable/bg_input" android:hint="Estoque" android:inputType="number" android:paddingHorizontal="14dp" />
        <Spinner android:id="@+id/spinner_categoria" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:background="@drawable/bg_input" android:paddingHorizontal="8dp" />
        <EditText android:id="@+id/edt_descricao" android:layout_width="match_parent" android:layout_height="100dp" android:layout_marginTop="10dp" android:background="@drawable/bg_input" android:gravity="top" android:hint="Descrição" android:padding="14dp" />

        <TextView
            android:id="@+id/btn_salvar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_btn_primary"
            android:gravity="center"
            android:text="@string/salvar"
            android:textColor="@color/text_dark"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
