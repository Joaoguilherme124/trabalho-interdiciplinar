<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_creme"
    android:orientation="vertical">

    <include
        android:id="@+id/include_demo"
        layout="@layout/view_demo_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:accessibilityHeading="true"
        android:fontFamily="@font/barlow_condensed_bold"
        android:includeFontPadding="false"
        android:text="@string/fila_titulo"
        android:textAllCaps="true"
        android:textColor="@color/brand_vinho"
        android:textSize="36sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chip_ativos"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_paella_chip_selected"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter_variable"
            android:gravity="center"
            android:minWidth="48dp"
            android:paddingHorizontal="18dp"
            android:text="@string/fila_filtro_ativos"
            android:textColor="@color/brand_creme"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chip_historico"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_paella_chip"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter_variable"
            android:gravity="center"
            android:minWidth="48dp"
            android:paddingHorizontal="18dp"
            android:text="@string/fila_filtro_historico"
            android:textColor="@color/brand_vinho"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_pedidos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp" />

        <LinearLayout
            android:id="@+id/estado_vazio_fila"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="40dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txt_vazio_titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/barlow_condensed_bold"
                android:gravity="center"
                android:textAllCaps="true"
                android:textColor="@color/brand_vinho"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/txt_vazio_texto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/inter_variable"
                android:gravity="center"
                android:textColor="@color/brand_grafite_muted"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
