<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_notificacoes"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_creme"
    android:orientation="vertical">

    <include
        android:id="@+id/include_demo"
        layout="@layout/view_demo_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_md">

            <TextView
                android:id="@+id/btn_voltar"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:drawableStart="@drawable/ic_back"
                android:drawablePadding="6dp"
                android:drawableTint="@color/brand_vinho"
                android:focusable="true"
                android:fontFamily="@font/inter_variable"
                android:gravity="center_vertical"
                android:text="@string/detalhe_voltar"
                android:textColor="@color/brand_vinho"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/barlow_condensed_bold"
                android:includeFontPadding="false"
                android:text="@string/central_titulo"
                android:textAllCaps="true"
                android:textColor="@color/brand_vinho"
                android:textSize="36sp" />

            <TextView
                android:id="@+id/aviso_sistema"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/inter_variable"
                android:text="@string/notif_desligadas_aviso"
                android:textColor="@color/brand_grafite_muted"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/lista_avisos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/estado_vazio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="28dp"
                        android:layout_height="10dp"
                        android:background="@color/brand_paprica"
                        android:importantForAccessibility="no" />

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginStart="4dp"
                        android:background="@color/brand_mediterraneo"
                        android:importantForAccessibility="no" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/barlow_condensed_bold"
                    android:text="@string/central_vazio_titulo"
                    android:textAllCaps="true"
                    android:textColor="@color/brand_grafite"
                    android:textSize="28sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_variable"
                    android:text="@string/central_vazio_texto"
                    android:textColor="@color/brand_grafite_muted"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
