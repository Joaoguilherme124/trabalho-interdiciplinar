<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_creme"
    android:orientation="vertical">

    <include
        android:id="@+id/include_demo"
        layout="@layout/view_demo_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_md">

            <TextView
                android:id="@+id/btn_voltar"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:drawableStart="@drawable/ic_back"
                android:drawablePadding="6dp"
                android:drawableTint="@color/brand_vinho"
                android:focusable="true"
                android:fontFamily="@font/inter_variable"
                android:gravity="center_vertical"
                android:text="@string/detalhe_voltar"
                android:textColor="@color/brand_vinho"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/barlow_condensed_bold"
                android:text="@string/checkout_titulo"
                android:textAllCaps="true"
                android:textColor="@color/brand_vinho"
                android:textSize="36sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_variable"
                android:text="@string/checkout_descricao"
                android:textColor="@color/brand_grafite_muted"
                android:textSize="14sp" />

            <!-- Resumo do pedido -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:fontFamily="@font/barlow_condensed_bold"
                android:text="@string/checkout_secao_pedido"
                android:textAllCaps="true"
                android:textColor="@color/brand_vinho"
                android:textSize="24sp" />

            <LinearLayout
                android:id="@+id/lista_itens"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="@dimen/space_xs"
                android:background="@color/line" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_variable"
                    android:text="@string/checkout_subtotal"
                    android:textColor="@color/brand_grafite_muted"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txt_subtotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_variable"
                    android:textColor="@color/brand_grafite"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/barlow_condensed_bold"
                    android:text="@string/checkout_total"
                    android:textAllCaps="true"
                    android:textColor="@color/brand_grafite"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/txt_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/barlow_condensed_bold"
                    android:textColor="@color/brand_vinho"
                    android:textSize="34sp" />
            </LinearLayout>

            <!-- Forma de pagamento -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:fontFamily="@font/barlow_condensed_bold"
                android:text="@string/checkout_secao_pagamento"
                android:textAllCaps="true"
                android:textColor="@color/brand_vinho"
                android:textSize="24sp" />

            <LinearLayout
                android:id="@+id/opcao_pix"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:background="@drawable/bg_paella_opcao_pagamento"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:padding="@dimen/space_md">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_pix"
                    app:tint="@color/brand_mediterraneo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_variable"
                            android:text="@string/checkout_pix_titulo"
                            android:textColor="@color/brand_grafite"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_xs"
                            android:background="@drawable/bg_paella_chip"
                            android:fontFamily="@font/inter_variable"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="@string/checkout_pix_selo"
                            android:textColor="@color/brand_grafite_muted"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_variable"
                        android:text="@string/checkout_pix_desc"
                        android:textColor="@color/brand_grafite_muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <View
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="@dimen/space_sm"
                    android:background="@drawable/bg_paella_radio" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/opcao_cartao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:background="@drawable/bg_paella_opcao_pagamento"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:padding="@dimen/space_md">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_card"
                    app:tint="@color/brand_mediterraneo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_variable"
                            android:text="@string/checkout_cartao_titulo"
                            android:textColor="@color/brand_grafite"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_xs"
                            android:background="@drawable/bg_paella_chip"
                            android:fontFamily="@font/inter_variable"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="@string/checkout_cartao_selo"
                            android:textColor="@color/brand_grafite_muted"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_variable"
                        android:text="@string/checkout_cartao_desc"
                        android:textColor="@color/brand_grafite_muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <View
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="@dimen/space_sm"
                    android:background="@drawable/bg_paella_radio" />
            </LinearLayout>

            <!-- Painel Pix -->
            <LinearLayout
                android:id="@+id/painel_pix"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="horizontal"
                android:visibility="gone">

                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:background="@color/brand_mediterraneo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/barlow_condensed_bold"
                        android:text="@string/checkout_pix_painel_titulo"
                        android:textAllCaps="true"
                        android:textColor="@color/brand_grafite"
                        android:textSize="22sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_variable"
                        android:text="@string/checkout_pix_painel_texto"
                        android:textColor="@color/brand_grafite"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:fontFamily="@font/inter_variable"
                        android:text="@string/checkout_painel_valor"
                        android:textColor="@color/brand_grafite_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txt_valor_pix"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/barlow_condensed_bold"
                        android:textColor="@color/brand_vinho"
                        android:textSize="28sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Painel cartão -->
            <LinearLayout
                android:id="@+id/painel_cartao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_paella_cartao"
                    android:orientation="vertical"
                    android:padding="@dimen/space_md">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_variable"
                        android:text="@string/checkout_cartao_ilustrativo"
                        android:textAllCaps="true"
                        android:textColor="@color/brand_acafrao"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:fontFamily="@font/barlow_condensed_bold"
                        android:text="@string/checkout_cartao_numero"
                        android:textColor="@color/brand_creme"
                        android:textSize="26sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/inter_variable"
                            android:text="@string/checkout_cartao_titular"
                            android:textColor="@color/brand_creme"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_variable"
                            android:text="@string/checkout_cartao_validade"
                            android:textColor="@color/brand_creme"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:fontFamily="@font/inter_variable"
                    android:text="@string/checkout_cartao_painel_texto"
                    android:textColor="@color/brand_grafite"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:fontFamily="@font/inter_variable"
                    android:text="@string/checkout_painel_valor"
                    android:textColor="@color/brand_grafite_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txt_valor_cartao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/barlow_condensed_bold"
                    android:textColor="@color/brand_vinho"
                    android:textSize="28sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/space_md"
                android:fontFamily="@font/inter_variable"
                android:text="@string/checkout_aviso_sem_cobranca"
                android:textColor="@color/brand_grafite_muted"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Ação fixa no rodapé -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_md">

        <ImageView
            android:id="@+id/progresso"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="@dimen/space_sm"
            android:contentDescription="@string/checkout_processando_desc"
            android:src="@drawable/avd_loading_geometrico"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirmar"
            style="@style/Widget.Paella.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/inter_variable"
            android:text="@string/checkout_btn_escolha" />
    </LinearLayout>
</LinearLayout>
