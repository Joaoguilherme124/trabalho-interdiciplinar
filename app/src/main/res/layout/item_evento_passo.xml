<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/space_xs">

    <TextView
        android:id="@+id/passo_numero"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_paella_quadrado"
        android:fontFamily="@font/barlow_condensed_bold"
        android:gravity="center"
        android:textColor="@color/brand_acafrao"
        android:textSize="24sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/passo_titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_variable"
            android:textColor="@color/brand_grafite"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/passo_descricao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_variable"
            android:textColor="@color/brand_grafite_muted"
            android:textSize="14sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/passo_icone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="@dimen/space_xs"
        android:importantForAccessibility="no"
        app:tint="@color/brand_mediterraneo" />
</LinearLayout>
