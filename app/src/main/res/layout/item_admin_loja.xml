<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_home_card"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/txt_nome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/barlow_condensed_bold"
        android:includeFontPadding="false"
        android:textColor="@color/brand_vinho"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/txt_cnpj"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/inter_variable"
        android:textColor="@color/brand_grafite"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/txt_categoria"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_variable"
        android:textColor="@color/brand_grafite_muted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/txt_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_selo_adicionado"
        android:fontFamily="@font/inter_variable"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:textColor="@color/brand_creme"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/acoes_pendente"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_aprovar"
            style="@style/Widget.Paella.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:fontFamily="@font/inter_variable"
            android:minHeight="48dp"
            android:text="@string/aprovar"
            android:textColor="@color/brand_vinho" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_rejeitar"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/inter_variable"
            android:minHeight="48dp"
            android:text="@string/rejeitar"
            android:textColor="@color/brand_paprica"
            app:strokeColor="@color/brand_paprica" />
    </LinearLayout>
</LinearLayout>
