<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_merchant"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_creme">

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        style="@style/Widget.App.BottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_nav_arredondada"
        android:clipToOutline="true"
        app:backgroundTint="@null"
        app:itemIconTint="@color/bottom_nav_buyer_color"
        app:itemTextAppearanceActive="@style/TextAppearance.App.BottomNav"
        app:itemTextAppearanceInactive="@style/TextAppearance.App.BottomNav"
        app:itemTextColor="@color/bottom_nav_buyer_color"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/menu_merchant_bottom" />
</androidx.constraintlayout.widget.ConstraintLayout>
