<?xml version="1.0" encoding="utf-8"?>
<!-- Linha de opção do Perfil: ícone, título, descrição, selo opcional e seta. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/opcao_raiz"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_md"
        android:paddingVertical="@dimen/space_sm">

        <ImageView
            android:id="@+id/opcao_icone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            app:tint="@color/brand_vinho" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/opcao_titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_variable"
                android:textColor="@color/brand_grafite"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/opcao_descricao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_variable"
                android:textColor="@color/brand_grafite_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/opcao_selo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:background="@drawable/bg_paella_chip"
            android:fontFamily="@font/inter_variable"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="@string/perfil_em_breve"
            android:textColor="@color/brand_grafite_muted"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/opcao_seta"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="@dimen/space_xs"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/brand_grafite_muted" />
    </LinearLayout>

    <View
        android:id="@+id/opcao_divisor"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="56dp"
        android:background="@color/line" />
</LinearLayout>
