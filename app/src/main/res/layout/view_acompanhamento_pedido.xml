<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_acompanhamento"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="#FFFFFDF9"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:rippleColor="@color/brand_acafrao"
    app:strokeColor="@color/brand_acafrao"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:id="@+id/acomp_cabecalho"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_home_sacola"
                app:tint="@color/brand_vinho" />

            <LinearLayout
                android:id="@+id/acomp_coluna_texto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/acomp_titulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/barlow_condensed_bold"
                    android:includeFontPadding="false"
                    android:text="@string/acomp_titulo"
                    android:textColor="@color/brand_vinho"
                    android:textSize="21sp" />

                <TextView
                    android:id="@+id/acomp_subtitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_variable"
                    android:textColor="@color/brand_grafite"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/acomp_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_acomp_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_home_relogio"
                    app:tint="@color/brand_vinho" />

                <TextView
                    android:id="@+id/acomp_chip_texto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/inter_variable"
                    android:maxWidth="110dp"
                    android:textColor="@color/brand_vinho"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/acomp_linha_etapas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:baselineAligned="false"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/acomp_frase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/inter_variable"
            android:textColor="@color/brand_grafite"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/acomp_btn_qr"
            style="@style/Widget.Paella.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/inter_variable"
            android:minHeight="48dp"
            android:text="@string/acomp_mostrar_qr"
            android:textColor="@color/brand_vinho"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
