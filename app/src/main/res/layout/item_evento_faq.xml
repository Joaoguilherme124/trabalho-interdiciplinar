<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/faq_cabecalho"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:contentDescription="@string/cd_expandir"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="@dimen/touch_target"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_md"
        android:paddingVertical="@dimen/space_sm">

        <TextView
            android:id="@+id/faq_pergunta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/inter_variable"
            android:textColor="@color/brand_grafite"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/faq_seta"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="@dimen/space_xs"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_expand_more"
            app:tint="@color/brand_vinho" />
    </LinearLayout>

    <TextView
        android:id="@+id/faq_resposta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_variable"
        android:paddingBottom="@dimen/space_sm"
        android:paddingHorizontal="@dimen/space_md"
        android:textColor="@color/brand_grafite_muted"
        android:textSize="14sp"
        android:visibility="gone" />

    <View
        android:id="@+id/faq_divisor"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />
</LinearLayout>
