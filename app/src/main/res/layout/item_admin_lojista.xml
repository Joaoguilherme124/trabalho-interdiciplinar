<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_home_card"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/txt_nome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/barlow_condensed_bold"
        android:includeFontPadding="false"
        android:textColor="@color/brand_vinho"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/txt_email"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/inter_variable"
        android:textColor="@color/brand_grafite"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/txt_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_selo_adicionado"
        android:fontFamily="@font/inter_variable"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:textColor="@color/brand_creme"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
