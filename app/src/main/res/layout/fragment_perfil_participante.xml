<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_creme"
    android:orientation="vertical">

    <include
        android:id="@+id/include_demo"
        layout="@layout/view_demo_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/perfil_conteudo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_md">

            <!-- 1. Cabeçalho -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_variable"
                android:text="@string/perfil_marca"
                android:textAllCaps="true"
                android:textColor="@color/brand_paprica"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/barlow_condensed_bold"
                android:text="@string/perfil_titulo"
                android:textAllCaps="true"
                android:textColor="@color/brand_vinho"
                android:textSize="36sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_variable"
                android:text="@string/perfil_descricao"
                android:textColor="@color/brand_grafite_muted"
                android:textSize="14sp" />

            <!-- 2. Participante -->
            <LinearLayout
                android:id="@+id/cartao_participante"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_paella_header"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_md">

                <TextView
                    android:id="@+id/txt_iniciais"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_paella_avatar"
                    android:fontFamily="@font/barlow_condensed_bold"
                    android:gravity="center"
                    android:textColor="@color/brand_vinho"
                    android:textSize="30sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txt_nome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/barlow_condensed_bold"
                        android:textColor="@color/brand_creme"
                        android:textSize="26sp" />

                    <TextView
                        android:id="@+id/txt_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_variable"
                        android:textColor="@color/brand_creme"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:background="@color/brand_acafrao"
                        android:fontFamily="@font/inter_variable"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="@string/perfil_participante"
                        android:textAllCaps="true"
                        android:textColor="@color/brand_grafite"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- 3 e 4. Conta -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:fontFamily="@font/barlow_condensed_bold"
                android:text="@string/perfil_secao_conta"
                android:textAllCaps="true"
                android:textColor="@color/brand_vinho"
                android:textSize="22sp" />

            <LinearLayout
                android:id="@+id/grupo_conta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:background="@drawable/bg_paella_chip"
                android:orientation="vertical" />

            <!-- 5. Evento e ajuda -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:fontFamily="@font/barlow_condensed_bold"
                android:text="@string/perfil_secao_evento"
                android:textAllCaps="true"
                android:textColor="@color/brand_vinho"
                android:textSize="22sp" />

            <LinearLayout
                android:id="@+id/grupo_evento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:background="@drawable/bg_paella_chip"
                android:orientation="vertical" />

            <!-- 6. Sair -->
            <LinearLayout
                android:id="@+id/grupo_sair"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:background="@drawable/bg_paella_chip"
                android:orientation="vertical" />

            <!-- 7. Rodapé -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:layout_marginBottom="@dimen/space_md"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/barlow_condensed_bold"
                    android:text="@string/perfil_rodape_nome"
                    android:textAllCaps="true"
                    android:textColor="@color/brand_vinho"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_variable"
                    android:text="@string/perfil_rodape_iniciativa"
                    android:textColor="@color/brand_grafite_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txt_versao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_variable"
                    android:textColor="@color/brand_grafite_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
