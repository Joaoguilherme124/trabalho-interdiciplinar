<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_recuperar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_creme"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_md">

        <TextView
            android:id="@+id/btn_voltar"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:drawableStart="@drawable/ic_back"
            android:drawablePadding="6dp"
            android:drawableTint="@color/brand_vinho"
            android:focusable="true"
            android:fontFamily="@font/inter_variable"
            android:gravity="center_vertical"
            android:text="@string/detalhe_voltar"
            android:textColor="@color/brand_vinho"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/barlow_condensed_bold"
            android:includeFontPadding="false"
            android:text="@string/recuperar_headline"
            android:textAllCaps="true"
            android:textColor="@color/brand_vinho"
            android:textSize="32sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/inter_variable"
            android:text="@string/recuperar_apoio"
            android:textColor="@color/brand_grafite_muted"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:fontFamily="@font/inter_variable"
            android:labelFor="@id/edt_email"
            android:text="@string/hint_email"
            android:textColor="@color/brand_grafite"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edt_email"
            style="@style/Widget.Paella.Campo"
            android:autofillHints="emailAddress"
            android:hint="@string/hint_email"
            android:inputType="textEmailAddress" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_enviar"
            style="@style/Widget.Paella.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:fontFamily="@font/inter_variable"
            android:text="@string/recuperar_continuar"
            android:textColor="@color/brand_vinho" />
    </LinearLayout>
</ScrollView>
