<?xml version="1.0" encoding="utf-8"?>
<!-- Indicador de seleção (único por vez): vazio ou preenchido em vinho. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <stroke
                        android:width="2dp"
                        android:color="@color/brand_vinho" />
                    <size
                        android:width="22dp"
                        android:height="22dp" />
                </shape>
            </item>
            <item
                android:bottom="5dp"
                android:left="5dp"
                android:right="5dp"
                android:top="5dp">
                <shape android:shape="oval">
                    <solid android:color="@color/brand_vinho" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="2dp"
                android:color="@color/brand_grafite_muted" />
            <size
                android:width="22dp"
                android:height="22dp" />
        </shape>
    </item>
</selector>
