<?xml version="1.0" encoding="utf-8"?>
<!-- Campo do Login: borda vinho suave; foco engrossa a borda; erro usa páprica (state_activated). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFDF9" />
            <corners android:radius="10dp" />
            <stroke
                android:width="2dp"
                android:color="@color/brand_paprica" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="10dp" />
            <stroke
                android:width="2dp"
                android:color="@color/brand_vinho" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFDF9" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1dp"
                android:color="#666A234F" />
        </shape>
    </item>
</selector>
