<?xml version="1.0" encoding="utf-8"?>
<!-- Opção de pagamento: borda discreta; selecionada ganha borda vinho e fundo creme. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_creme" />
            <corners android:radius="@dimen/radius_brand" />
            <stroke
                android:width="2dp"
                android:color="@color/brand_vinho" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <corners android:radius="@dimen/radius_brand" />
            <stroke
                android:width="1dp"
                android:color="@color/line" />
        </shape>
    </item>
</selector>
